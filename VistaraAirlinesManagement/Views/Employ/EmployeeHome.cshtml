
@{
    ViewBag.Title = "EmployeeHome";
    Layout = "~/Views/Shared/Mylayout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <title>BlueWings Airlines</title>
    <link href="~/Content/Mystyles/adminhome.css" rel="stylesheet" />
</head>
<body>

    <header>
        <div class="logo">✈ BLUEWINGS AIRLINES</div>

        <nav>
            @Html.ActionLink("Home", "EmployeeHome")
            @Html.ActionLink("Menu", "EmployeeMenu")
            <a href="#">Services</a>
            <a href="#">Contact</a>
        </nav>

    </header>

    <section class="hero">
        <div class="overlay"></div>

        <div class="hero-content">
            <p class="tagline">WELCOME TO BLUEWINGS AIRLINES</p>

            <h1>
                Discover The World<br>
                With <span>BlueWings Airlines</span>
            </h1>

            <p class="description">
                Experience extraordinary journeys,
                premium comfort and unforgettable destinations.
            </p>


        </div>

        <div class="bottom-text">
            YOUR JOURNEY BEGINS HERE
        </div>
    </section>

</body>
</html>
