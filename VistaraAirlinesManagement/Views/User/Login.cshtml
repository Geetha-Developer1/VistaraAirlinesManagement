@model VistaraAirlinesManagement.Models.LoginModel
    
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
   <!DOCTYPE html>
<html>
<head>
    <title>BlueWings Airlines Login</title>
    <link rel="stylesheet" href="~/Content/Mystyles/Login.css">
</head>

<body>

    <div class="background">

        <div class="login-card">

            <div class="logo">
                ✈
            </div>

            <h1>BLUWINGS AIRLINES</h1>

            <p class="welcome">
                Welcome Back!
            </p>

            <p class="subtitle">
                Login to your airline account
            </p>

            @using (Html.BeginForm("Login", "User", FormMethod.Post))
            {

                <div class="input-group">
                    @Html.LabelFor(e => e.Username)
                    @Html.TextBoxFor(e => e.Username)
                </div>

                <div class="input-group">
                    @Html.LabelFor(e => e.Password)
                    @Html.PasswordFor(e => e.Password)
                </div>

                <div class="role-title">
                    Login As
                </div>

                <div class="role-selection">

                    <label class="role-option">
                        @Html.RadioButtonFor(e => e.role, "Administrator")Administrator

                    </label>

                    <label class="role-option">
                        @Html.RadioButtonFor(e => e.role, "Employee")Employee
                    </label>

                </div>

                <button type="submit">
                    LOGIN NOW <span>→</span>
                </button>

            }

                <div class="footer">
                    © 2026 SKYLINE AIRWAYS
                    <br>
                    Your Journey, Our Responsibility
                </div>

            </div>

    </div>

</body>
</html>


